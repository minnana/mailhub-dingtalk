  <dependencies><php min-version="8.3"/><nextcloud min-version="34" max-version="34"/></dependencies>
  <background-jobs><job>OCA\MailhubDingtalk\BackgroundJob\NotificationJob</job></background-jobs>
  <settings>
    <admin>OCA\MailhubDingtalk\Settings\Admin</admin>
