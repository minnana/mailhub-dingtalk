user nginx;
worker_processes auto;
pid /var/run/nginx.pid;
error_log /dev/stderr warn;
events { worker_connections 2048; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    # Do not write request URLs or OAuth authorization codes to access logs.
    access_log off;
    sendfile on;
    server_tokens off;
    client_max_body_size 64m;
    client_body_timeout 120s;
    keepalive_timeout 65;
    server {
        listen 8443 ssl default_server;
        server_name @@DOMAIN@@;
        ssl_certificate /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
        add_header Strict-Transport-Security "max-age=15552000" always;
        if ($host != @@DOMAIN@@) { return 444; }
        location = / { return 302 https://@@DOMAIN@@:@@PUBLIC_PORT@@/index.php/apps/mailhub_dingtalk/; }
        location = /.well-known/carddav { return 301 https://@@DOMAIN@@:@@PUBLIC_PORT@@/remote.php/dav/; }
        location = /.well-known/caldav { return 301 https://@@DOMAIN@@:@@PUBLIC_PORT@@/remote.php/dav/; }
        location / {
            proxy_pass http://app:80;
            proxy_http_version 1.1;
            proxy_set_header Host @@DOMAIN@@:@@PUBLIC_PORT@@;
            proxy_set_header X-Forwarded-Host @@DOMAIN@@:@@PUBLIC_PORT@@;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Forwarded-Port @@PUBLIC_PORT@@;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header Connection "";
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_request_buffering off;
        }
    }
}
